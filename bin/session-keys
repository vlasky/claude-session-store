#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=bin/_session-lock
source "$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd)/_session-lock"

usage() {
  echo "Usage: session-keys [--shared]"
  echo ""
  echo "List all keys currently stored in the session."
  echo "Outputs one key per line. Empty output if no keys exist."
  echo ""
  echo "Options:"
  echo "  --shared    List keys in shared namespace"
  echo ""
  echo "Examples:"
  echo "  session-keys"
  echo "  session-keys --shared"
  echo "  session-keys | wc -l"
  exit 1
}

if [ -z "${CLAUDE_SESSION_DIR:-}" ]; then
  echo "Error: CLAUDE_SESSION_DIR not set. Is the claude-session-store plugin active?" >&2
  exit 1
fi

parse_shared_flag "$@"
set -- ${PARSE_ARGS[@]+"${PARSE_ARGS[@]}"}

if [ "${1:-}" = "--help" ]; then
  usage
fi

STORE_DIR=$(resolve_store_dir)

if [ -d "$STORE_DIR" ]; then
  find "$STORE_DIR" -maxdepth 1 -type f -exec basename {} \; | sort
fi
